{
  "name": "memesquid",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "template:add": "tsx scripts/templates/add.ts",
    "template:group:add": "tsx scripts/templates/addGroup.ts",
    "template:image:update": "tsx scripts/templates/updateImage.ts",
    "templates:check": "tsx scripts/templates/check.ts",
    "templates:test": "tsx --test scripts/templates/*.test.ts src/templateCatalog/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm run templates:check && pnpm run templates:test && pnpm run typecheck && pnpm run lint && pnpm run knip && pnpm run format:check && pnpm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "canvg": "^4.0.3",
    "konva": "^10.3.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.2.5",
    "react-konva-utils": "^2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@clack/prompts": "1.7.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "^8.2.2",
    "wrangler": "4.125.0"
  },
  "engines": {
    "node": ">=26.3.1 <27",
    "pnpm": "11.23.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.3.1 <27",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "error"
    }
  }
}
