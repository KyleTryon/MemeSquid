{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "memesquid",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "memesquid.com",
      "custom_domain": true,
    },
  ],
}
